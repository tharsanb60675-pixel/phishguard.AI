# PhishGuard AI — Backend Environment Configuration Example
# Copy this file to .env and insert your real keys

APP_ENV=development
DEBUG=True

# Real AI / LLM Integration (OpenAI or any OpenAI-compatible provider like Groq, OpenRouter, DeepSeek, Local Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./phishguard.db
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=phishguard_unstructured

# JWT Security
JWT_SECRET=phishguard_ai_super_secret_jwt_key_2026_capstone_demo_prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
