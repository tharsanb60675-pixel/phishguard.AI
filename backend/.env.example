# PhishGuard AI — Backend Environment Configuration
# Copy this file to .env and configure as appropriate for your environment.

APP_NAME="PhishGuard AI"
APP_ENV=production
DEBUG=False
API_V1_STR=/api/v1

# Security & Tokens
JWT_SECRET=phishguard_ai_super_secret_jwt_key_2026_capstone_demo_prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (SQLite default / PostgreSQL / MySQL)
DATABASE_URL=sqlite+aiosqlite:///./phishguard.db
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=phishguard_unstructured

# AI / LLM Configuration (OpenAI, Groq, OpenRouter, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# CORS Configuration
# Comma-separated list of allowed origins, or '*' to allow all.
# Vercel deployments (*.vercel.app) and localhost are supported by default.
CORS_ORIGINS=*
FRONTEND_URL=https://your-phishguard-frontend.vercel.app
