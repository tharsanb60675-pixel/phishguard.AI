# PhishGuard AI Frontend Deployment Environment Variables
# In production (e.g. Vercel, Netlify, Render), set VITE_API_BASE_URL to your deployed FastAPI backend URL.

# FastAPI Backend Base API URL (e.g. https://your-backend-service.onrender.com/api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# AI Chatbot Service Endpoint (Optional fallback)
VITE_AI_API_URL=http://localhost:8000/api/v1/chat
VITE_AI_API_KEY=
