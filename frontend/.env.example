# PhishGuard AI — Frontend Production & Development Environment Variables
#
# When deploying to Vercel:
# 1. Go to Project Settings -> Environment Variables
# 2. Add VITE_API_BASE_URL set to your deployed Render backend URL.
#    Examples:
#    - https://your-phishguard-backend.onrender.com
#    - https://your-phishguard-backend.onrender.com/api/v1
#    (The frontend automatically normalizes the URL and handles trailing slashes)

VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional Groq/OpenAI compatible AI direct endpoint (defaults to backend /chat proxy)
VITE_AI_API_URL=
VITE_AI_API_KEY=
